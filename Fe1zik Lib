        Size = UDim2.fromOffset(20, 20),
        Position = UDim2.new(1, -28, 0.5, -10),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = "v",
        TextColor3 = T.SubText,
        TextSize = 14,
        Parent = frame,
    })

    local listFrame = create("Frame", {
        Name = "List",
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 1, 4),
        BackgroundColor3 = T.Background,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 10,
        Parent = frame,
    })
    corner(listFrame, 6)
    stroke(listFrame, T.Accent, 1)

    local listLayout = create("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = listFrame,
    })

    local function rebuildList()
        for _, c in ipairs(listFrame:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        local y = 0
        for _, opt in ipairs(options) do
            local ob = create("TextButton", {
                Size = UDim2.new(1, 0, 0, 28),
                Position = UDim2.fromOffset(0, y),
                BackgroundColor3 = T.Element,
                BackgroundTransparency = 0.3,
                Text = "  " .. opt,
                TextColor3 = T.Text,
                Font = Enum.Font.Gotham,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                LayoutOrder = y,
                Parent = listFrame,
            })
            y = y + 28
            ob.MouseButton1Click:Connect(function()
                current = opt
                btn.Parent:FindFirstChildWhichIsA("TextLabel").Text = opt
                listFrame.Visible = false
                listFrame.Size = UDim2.new(1, 0, 0, 0)
                open = false
                if config.Callback then config.Callback(opt) end
            end)
        end
        listFrame.Size = UDim2.new(1, 0, 0, #options * 28)
    end

    rebuildList()

    btn.MouseButton1Click:Connect(function()
        open = not open
        listFrame.Visible = open
    end)

    return {
        Set = function(v)
            current = v
            btn.Parent:FindFirstChildWhichIsA("TextLabel").Text = v
            if config.Callback then config.Callback(v) end
        end,
        Get = function() return current end,
    }
end

-- ============================ PARAGRAPH ============================
function BBS:AddParagraph(tab, config)
    local T = self.Theme
    local frame = create("Frame", {
        Name = "Para_" .. (config.Title or "P"),
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = T.Element,
        BackgroundTransparency = 0.3,
        Parent = tab.Container,
    })
    corner(frame, 6)

    create("TextLabel", {
        Size = UDim2.new(1, -16, 0, 16),
        Position = UDim2.fromOffset(12, 4),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = config.Title or "",
        TextColor3 = T.Accent,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    local body = create("TextLabel", {
        Size = UDim2.new(1, -16, 0, 16),
        Position = UDim2.fromOffset(12, 20),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = config.Content or "",
        TextColor3 = T.Text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    return {
        Set = function(text)
            body.Text = text
        end,
    }
end

