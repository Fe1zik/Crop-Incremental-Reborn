function BBS.new(config)
    local self = setmetatable({}, BBS)
    self.Config = config or {}
    self.ThemeName = self.Config.Theme or "Amethyst"
    self.Theme = THEMES[self.ThemeName]
    self.MinimizeKey = self.Config.MinimizeKey or Enum.KeyCode.LeftControl
    self.Transparency = self.Config.Transparency or 0
    self.Tabs = {}
    self.Elements = {}
    self.ActiveTab = nil
    self.Minimized = false
    self:Build()
    self:BindKeys()
    return self
end

