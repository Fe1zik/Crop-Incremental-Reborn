-- ============================ TOGGLE ============================
function BBS:AddToggle(tab, config)
    local T = self.Theme
    local state = config.Default or false

    local frame = create("Frame", {
        Name = "Toggle_" .. (config.Title or "T"),
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = T.Element,
        BackgroundTransparency = 0.3,
        Parent = tab.Container,
    })
    corner(frame, 6)

    create("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = config.Title or "Toggle",
        TextColor3 = T.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    -- Кнопка toggle
    local toggleBtn = create("Frame", {
        Size = UDim2.fromOffset(40, 20),
        Position = UDim2.new(1, -52, 0.5, -10),
        BackgroundColor3 = state and T.Toggle or T.ToggleOff,
        Parent = frame,
    })
    corner(toggleBtn, 10)

    local knob = create("Frame", {
        Size = UDim2.fromOffset(16, 16),
        Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        Parent = toggleBtn,
    })
    corner(knob, 8)

    local btn = create("TextButton", {
        Size = UDim2.fromOffset(40, 20),
        Position = UDim2.new(1, -52, 0.5, -10),
        BackgroundTransparency = 1,
        Text = "",
        Parent = frame,
    })

    local callback = config.Callback or function() end

    btn.MouseButton1Click:Connect(function()
        state = not state
        toggleBtn.BackgroundColor3 = state and T.Toggle or T.ToggleOff
        knob.Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        callback(state)
    end)

    return {
        Set = function(v)
            state = v
            toggleBtn.BackgroundColor3 = v and T.Toggle or T.ToggleOff
            knob.Position = v and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
            callback(v)
        end,
        Get = function() return state end,
    }
end

-- ============================ BUTTON ============================
function BBS:AddButton(tab, config)
    local T = self.Theme
    local frame = create("TextButton", {
        Name = "Button_" .. (config.Title or "B"),
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = T.Element,
        BackgroundTransparency = 0.3,
        Text = config.Title or "Button",
        TextColor3 = T.Text,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        Parent = tab.Container,
    })
    corner(frame, 6)

    frame.MouseEnter:Connect(function()
        frame.BackgroundColor3 = T.ElementHover
        frame.BackgroundTransparency = 0.15
    end)
    frame.MouseLeave:Connect(function()
        frame.BackgroundColor3 = T.Element
        frame.BackgroundTransparency = 0.3
    end)

    if config.Callback then
        frame.MouseButton1Click:Connect(config.Callback)
    end

    return frame
end

