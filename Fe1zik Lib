-- ============================ UTILS ============================
local function create(className, props)
    local obj = Instance.new(className)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    return obj
end

local function corner(parent, radius)
    return create("UICorner", {
        CornerRadius = UDim.new(0, radius or 6),
        Parent = parent,
    })
end

local function stroke(parent, color, thickness)
    return create("UIStroke", {
        Color = color or Color3.fromRGB(0, 0, 0),
        Thickness = thickness or 1,
        Transparency = 0.5,
        Parent = parent,
    })
end

-- ============================ NOTIFY SYSTEM ============================
local notifyHolder
local function getNotifyHolder()
    if notifyHolder and notifyHolder.Parent then return notifyHolder end
    local gui = create("ScreenGui", {
        Name = "BBS_Notify",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = game:GetService("CoreGui"),
    })
    notifyHolder = gui
    return gui
end

-- ============================ WINDOW ============================
function BBS.new(config)
    local self = setmetatable({}, BBS)

    self.Config = config or {}
    self.ThemeName = self.Config.Theme or "Amethyst"
    self.Theme = THEMES[self.ThemeName]
    self.MinimizeKey = self.Config.MinimizeKey or Enum.KeyCode.LeftControl
    self.Transparency = self.Config.Transparency or 0

    self.Tabs = {}
    self.Connections = {}
    self.Elements = {}
    self.ScreenGui = nil
    self.MainFrame = nil
    self.ActiveTab = nil
    self.Minimized = false

    self:Build()
    self:BindKeys()
    return self
end

