function BBS:BindKeys()
    local UIS = game:GetService("UserInputService")
    self.KeyConnection = UIS.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == self.MinimizeKey then
            self:ToggleMinimize()
        end
    end)
end

function BBS:ToggleMinimize()
    if not self.MainFrame then return end
    self.Minimized = not self.Minimized
    if self.Minimized then
        -- Сохраняем позицию и размер
        self._lastSize = self.MainFrame.Size
        self._lastPosition = self.MainFrame.Position
        self.MainFrame:TweenSize(
            UDim2.fromOffset(600, 36),
            Enum.EasingDirection.Out,
            Enum.EasingStyle.Quad,
            0.15,
            true
        )
    else
        self.MainFrame:TweenSize(
            self._lastSize or UDim2.fromOffset(600, 420),
            Enum.EasingDirection.Out,
            Enum.EasingStyle.Quad,
            0.15,
            true
        )
    end
end

function BBS:SetMinimizeKey(keyCode)
    self.MinimizeKey = keyCode
    getgenv().BBS_UI = getgenv().BBS_UI or {}
    getgenv().BBS_UI.MinimizeKey = keyCode
end

function BBS:SetTheme(themeName)
    if not THEMES[themeName] then return end
    self.ThemeName = themeName
    self.Theme = THEMES[themeName]
    getgenv().BBS_UI = getgenv().BBS_UI or {}
    getgenv().BBS_UI.Theme = themeName
    self:RefreshTheme()
end

function BBS:RefreshTheme()
    local T = self.Theme
    if not self.MainFrame then return end
    self.MainFrame.BackgroundColor3 = T.Background

    -- Обновляем все элементы
    for _, obj in ipairs(self.ScreenGui:GetDescendants()) do
        if obj:IsA("TextLabel") then
            if obj.Name == "SubText" then
                obj.TextColor3 = T.SubText
            else
                obj.TextColor3 = T.Text
            end
        end
        if obj:IsA("TextButton") then
            obj.TextColor3 = T.Text
        end
    end
end

function BBS:SetTransparency(value)
    self.Transparency = value
    getgenv().BBS_UI = getgenv().BBS_UI or {}
    getgenv().BBS_UI.Transparency = value
    self:ApplyTransparency()
end

function BBS:ApplyTransparency()
    if not self.MainFrame then return end
    -- Прозрачность фона окна
    local a = (self.Transparency or 0) / 100 * 0.6
    self.MainFrame.BackgroundTransparency = math.clamp(a, 0, 0.7)
end

function BBS:Notify(cfg)
    local holder = getNotifyHolder()
    local T = self.Theme

    local frame = create("Frame", {
        Size = UDim2.fromOffset(280, 60),
        Position = UDim2.new(1, -300, 0, 20 + (#holder:GetChildren() - 1) * 70),
        BackgroundColor3 = T.Background,
        BorderSizePixel = 0,
        Parent = holder,
    })
    corner(frame, 8)
    stroke(frame, T.Accent, 1.5)

    create("TextLabel", {
        Size = UDim2.new(1, -16, 0, 22),
        Position = UDim2.fromOffset(12, 8),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = cfg.Title or "Notification",
        TextColor3 = T.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    create("TextLabel", {
        Size = UDim2.new(1, -16, 0, 20),
        Position = UDim2.fromOffset(12, 30),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = cfg.Content or "",
        TextColor3 = T.SubText,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    task.delay(cfg.Duration or 3, function()
        if frame and frame.Parent then
            frame:Destroy()
        end
    end)
end

-- ============================ TAB ============================
function BBS:AddTab(config)
    local tab = {
        Name = config.Title or "Tab",
        Icon = config.Icon or "",
        Container = nil,
        Button = nil,
        Parent = self,
    }

    -- Кнопка в sidebar
    local btn = create("TextButton", {
        Name = "Tab_" .. tab.Name,
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = self.Theme.Element,
        BackgroundTransparency = 0.4,
        Text = "  " .. tab.Name,
        TextColor3 = self.Theme.Text,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = self.SidebarList,
    })
    corner(btn, 6)
    tab.Button = btn

    -- Контейнер контента
    local container = create("ScrollingFrame", {
        Name = "Content_" .. tab.Name,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = self.Theme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        Parent = self.ContentFrame,
    })
    create("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6),
        Parent = container,
    })
    create("UIPadding", {
        PaddingRight = UDim.new(0, 6),
        Parent = container,
    })
    tab.Container = container

    -- Клик
    btn.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    table.insert(self.Tabs, tab)
    if #self.Tabs == 1 then
        self:SelectTab(tab)
    end

    return tab
end

function BBS:SelectTab(tab)
    if self.ActiveTab then
        self.ActiveTab.Container.Visible = false
        self.ActiveTab.Button.BackgroundTransparency = 0.4
    end
    self.ActiveTab = tab
    tab.Container.Visible = true
    tab.Button.BackgroundTransparency = 0
end

