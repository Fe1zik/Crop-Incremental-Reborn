function BBS:AddSlider(tab, config)
    local T = self.Theme
    local minV = config.Min or 0
    local maxV = config.Max or 100
    local value = config.Default or minV
    local step = config.Step or 1

    local frame = create("Frame", {
        Name = "Slider",
        Size = UDim2.new(1, 0, 0, 46),
        BackgroundColor3 = T.Element,
        BackgroundTransparency = 0.5,
        Parent = tab.Container,
    })
    corner(frame, 8)

    create("TextLabel", {
        Name = "Label",
        Size = UDim2.new(0.6, -12, 0, 20),
        Position = UDim2.fromOffset(14, 5),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = config.Title or "Slider",
        TextColor3 = T.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    local valueLabel = create("TextLabel", {
        Name = "Value",
        Size = UDim2.new(0.4, -14, 0, 20),
        Position = UDim2.new(0.6, 0, 0, 5),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        Text = tostring(value),
        TextColor3 = T.Accent,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = frame,
    })

    local bg = create("Frame", {
        Size = UDim2.new(1, -28, 0, 4),
        Position = UDim2.new(0, 14, 0, 32),
        BackgroundColor3 = T.ToggleOff,
        Parent = frame,
    })
    corner(bg, 2)

    local fill = create("Frame", {
        Size = UDim2.new((value - minV) / (maxV - minV), 0, 1, 0),
        BackgroundColor3 = T.Accent,
        Parent = bg,
    })
    corner(fill, 2)

    -- Ползунок (кружок)
    local knob = create("Frame", {
        Size = UDim2.fromOffset(12, 12),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((value - minV) / (maxV - minV), 0, 0.5, 0),
        BackgroundColor3 = T.Accent,
        Parent = bg,
    })
    corner(knob, 6)
    stroke(knob, T.Text, 1, 0.3)

    local btn = create("TextButton", {
        Size = UDim2.new(1, 0, 3, 0),
        Position = UDim2.new(0, 0, -1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = bg,
    })

    local callback = config.Callback or function() end
    local dragging = false

    local function updateValue(x)
        local rel = math.clamp((x - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
        local raw = minV + (maxV - minV) * rel
        value = math.floor(raw / step + 0.5) * step
        value = math.clamp(value, minV, maxV)
        local alpha = (value - minV) / (maxV - minV)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        valueLabel.Text = tostring(value)
        callback(value)
    end

    btn.MouseButton1Down:Connect(function()
        dragging = true
        updateValue(UserInputService:GetMouseLocation().X)
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateValue(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    return {
        Set = function(v)
            value = math.clamp(v, minV, maxV)
            local alpha = (value - minV) / (maxV - minV)
            fill.Size = UDim2.new(alpha, 0, 1, 0)
            knob.Position = UDim2.new(alpha, 0, 0.5, 0)
            valueLabel.Text = tostring(value)
            callback(value)
        end,
        Get = function() return value end,
    }
end

