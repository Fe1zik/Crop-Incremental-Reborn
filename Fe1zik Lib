function BBS:AddDropdown(tab, config)
    local T = self.Theme
    local options = config.Values or {}
    local current = config.Default or options[1]
    local open = false

    local frame = create("Frame", {
        Name = "Dropdown",
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = T.Element,
        BackgroundTransparency = 0.5,
        Parent = tab.Container,
        ClipsDescendants = false,
        ZIndex = 5,
    })
    corner(frame, 8)

    local label = create("TextLabel", {
        Name = "Current",
        Size = UDim2.new(1, -40, 1, 0),
        Position = UDim2.fromOffset(14, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = current,
        TextColor3 = T.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    create("TextLabel", {
        Size = UDim2.fromOffset(20, 20),
        Position = UDim2.new(1, -28, 0.5, -10),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = "v",
        TextColor3 = T.SubText,
        TextSize = 14,
        Parent = frame,
    })

    local btn = create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = frame,
    })

    local listFrame = create("Frame", {
        Name = "List",
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 1, 4),
        BackgroundColor3 = T.Background2,
        BorderSizePixel = 0,
        Visible = false,
        ClipsDescendants = true,
        ZIndex = 10,
        Parent = frame,
    })
    corner(listFrame, 8)
    stroke(listFrame, T.Stroke, 1, 0.4)

    local listPad = create("UIPadding", {
        PaddingTop = UDim.new(0, 4),
        PaddingBottom = UDim.new(0, 4),
        PaddingLeft = UDim.new(0, 4),
        PaddingRight = UDim.new(0, 4),
        Parent = listFrame,
    })
    create("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2),
        Parent = listFrame,
    })

    local function rebuild()
        for _, c in ipairs(listFrame:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        for i, opt in ipairs(options) do
            local ob = create("TextButton", {
                Size = UDim2.new(1, 0, 0, 26),
                BackgroundColor3 = T.Element,
                BackgroundTransparency = 0.5,
                Text = "  " .. opt,
                TextColor3 = T.Text,
                Font = Enum.Font.Gotham,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                LayoutOrder = i,
                AutoButtonColor = false,
                Parent = listFrame,
            })
            corner(ob, 6)
            ob.MouseEnter:Connect(function()
                tween(ob, 0.15, {BackgroundTransparency = 0.2})
            end)
            ob.MouseLeave:Connect(function()
                tween(ob, 0.15, {BackgroundTransparency = 0.5})
            end)
            ob.MouseButton1Click:Connect(function()
                current = opt
                label.Text = opt
                tween(listFrame, 0.18, {Size = UDim2.new(1, 0, 0, 0)})
                task.delay(0.18, function() listFrame.Visible = false end)
                open = false
                if config.Callback then config.Callback(opt) end
            end)
        end
    end
    rebuild()

    btn.MouseButton1Click:Connect(function()
        open = not open
        if open then
            listFrame.Visible = true
            listFrame.Size = UDim2.new(1, 0, 0, 0)
            tween(listFrame, 0.18, {Size = UDim2.new(1, 0, 0, #options * 28 + 8)})
        else
            tween(listFrame, 0.18, {Size = UDim2.new(1, 0, 0, 0)})
            task.delay(0.18, function() listFrame.Visible = false end)
        end
    end)

    return {
        Set = function(v)
            current = v
            label.Text = v
            if config.Callback then config.Callback(v) end
        end,
        Get = function() return current end,
    }
end

