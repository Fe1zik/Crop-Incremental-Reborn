-- ============================ SLIDER ============================
function BBS:AddSlider(tab, config)
    local T = self.Theme
    local minV = config.Min or 0
    local maxV = config.Max or 100
    local value = config.Default or minV
    local step = config.Step or 1

    local frame = create("Frame", {
        Name = "Slider_" .. (config.Title or "S"),
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = T.Element,
        BackgroundTransparency = 0.3,
        Parent = tab.Container,
    })
    corner(frame, 6)

    create("TextLabel", {
        Size = UDim2.new(0.6, -12, 0, 20),
        Position = UDim2.fromOffset(12, 4),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = config.Title or "Slider",
        TextColor3 = T.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    local valueLabel = create("TextLabel", {
        Size = UDim2.new(0.4, -12, 0, 20),
        Position = UDim2.new(0.6, 0, 0, 4),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = tostring(value),
        TextColor3 = T.Accent,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = frame,
    })

    local sliderBg = create("Frame", {
        Size = UDim2.new(1, -24, 0, 6),
        Position = UDim2.new(0, 12, 0, 30),
        BackgroundColor3 = T.ToggleOff,
        Parent = frame,
    })
    corner(sliderBg, 3)

    local fill = create("Frame", {
        Size = UDim2.new((value - minV) / (maxV - minV), 0, 1, 0),
        BackgroundColor3 = T.Accent,
        Parent = sliderBg,
    })
    corner(fill, 3)

    local btn = create("TextButton", {
        Size = UDim2.new(1, 0, 2, 0),
        Position = UDim2.new(0, 0, -0.5, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = sliderBg,
    })

    local callback = config.Callback or function() end
    local dragging = false

    local function updateValue(x)
        local rel = math.clamp((x - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
        local raw = minV + (maxV - minV) * rel
        value = math.floor(raw / step + 0.5) * step
        value = math.clamp(value, minV, maxV)
        fill.Size = UDim2.new((value - minV) / (maxV - minV), 0, 1, 0)
        valueLabel.Text = tostring(value)
        callback(value)
    end

    btn.MouseButton1Down:Connect(function()
        dragging = true
        updateValue(game:GetService("UserInputService"):GetMouseLocation().X)
    end)

    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateValue(input.Position.X)
        end
    end)

    game:GetService("UserInputService").InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    return {
        Set = function(v)
            value = math.clamp(v, minV, maxV)
            fill.Size = UDim2.new((value - minV) / (maxV - minV), 0, 1, 0)
            valueLabel.Text = tostring(value)
            callback(value)
        end,
        Get = function() return value end,
    }
end

