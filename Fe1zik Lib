function BBS:BindKeys()
    self.KeyConnection = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == self.MinimizeKey then
            self:ToggleMinimize()
        end
    end)
end

function BBS:ToggleMinimize()
    if not self.MainFrame then return end
    self.Minimized = not self.Minimized
    local targetY = self.Minimized and 36 or 420
    tween(self.MainFrame, 0.25, {Size = UDim2.fromOffset(600, targetY)}, Enum.EasingStyle.Quart)
end

function BBS:SetMinimizeKey(keyCode)
    self.MinimizeKey = keyCode
    getgenv().BBS_UI = getgenv().BBS_UI or {}
    getgenv().BBS_UI.MinimizeKey = keyCode
end

function BBS:SetTheme(themeName)
    if not THEMES[themeName] then return end
    self.ThemeName = themeName
    self.Theme = THEMES[themeName]
    getgenv().BBS_UI = getgenv().BBS_UI or {}
    getgenv().BBS_UI.Theme = themeName
    self:RefreshTheme()
end

function BBS:RefreshTheme()
    local T = self.Theme
    if not self.MainFrame then return end
    tween(self.MainFrame, 0.2, {BackgroundColor3 = T.Background})
    if self.Topbar then tween(self.Topbar, 0.2, {BackgroundColor3 = T.Background2}) end
    if self.TitleLabel then tween(self.TitleLabel, 0.2, {TextColor3 = T.Text}) end
    -- Обновляем все дочерние
    for _, obj in ipairs(self.ScreenGui:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local n = obj.Name
            if n == "SubText" or n == "Subtitle" or n == "Value" then
                obj.TextColor3 = T.SubText
            else
                obj.TextColor3 = T.Text
            end
        end
    end
end

function BBS:SetTransparency(value)
    self.Transparency = value
    getgenv().BBS_UI = getgenv().BBS_UI or {}
    getgenv().BBS_UI.Transparency = value
    self:ApplyTransparency()
end

function BBS:ApplyTransparency()
    if not self.MainFrame then return end
    local a = (self.Transparency or 0) / 100 * 0.7
    a = math.clamp(a, 0, 0.7)
    -- Пробегаем по всем фреймам окна и ставим одинаковую прозрачность
    for _, obj in ipairs(self.MainFrame:GetDescendants()) do
        if obj:IsA("Frame") or obj:IsA("ImageLabel") then
            -- Пропускаем фреймы с изначальной прозрачностью 1 (невидимые контейнеры)
            if obj.BackgroundTransparency < 1 then
                obj.BackgroundTransparency = a
            end
        end
        if obj:IsA("TextButton") then
            if obj.BackgroundTransparency < 1 then
                obj.BackgroundTransparency = a
            end
        end
    end
    -- Применяем к самому главному
    self.MainFrame.BackgroundTransparency = a
end

function BBS:Notify(cfg)
    local holder = getNotifyHolder()
    local T = self.Theme
    local frame = create("Frame", {
        Size = UDim2.fromOffset(280, 60),
        Position = UDim2.new(1, 320, 0, 20),
        BackgroundColor3 = T.Background2,
        BorderSizePixel = 0,
        Parent = holder,
    })
    corner(frame, 8)
    stroke(frame, T.Stroke, 1, 0.4)

    create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 22),
        Position = UDim2.fromOffset(12, 8),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        Text = cfg.Title or "Notification",
        TextColor3 = T.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })
    create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.fromOffset(12, 30),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = cfg.Content or "",
        TextColor3 = T.SubText,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    -- Анимация появления
    local startPos = UDim2.new(1, 320, 0, 20)
    local endPos = UDim2.new(1, -300, 0, 20)
    frame.Position = startPos
    tween(frame, 0.35, {Position = endPos}, Enum.EasingStyle.Quart)

    task.delay(cfg.Duration or 3, function()
        if frame and frame.Parent then
            local t = tween(frame, 0.3, {Position = startPos, BackgroundTransparency = 1})
            t.Completed:Connect(function()
                frame:Destroy()
            end)
        end
    end)
end

-- ============================ TAB ============================
function BBS:AddTab(config)
    local T = self.Theme
    local tab = { Name = config.Title or "Tab", Parent = self }

    local btn = create("TextButton", {
        Name = "Tab_" .. tab.Name,
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = T.Element,
        BackgroundTransparency = 0.6,
        Text = "   " .. tab.Name,
        TextColor3 = T.Text,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
        Parent = self.SidebarList,
    })
    corner(btn, 8)
    tab.Button = btn

    local container = create("ScrollingFrame", {
        Name = "Content_" .. tab.Name,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 6,
        ScrollBarImageColor3 = T.Accent,
        ScrollBarImageTransparency = 0.3,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Visible = false,
        Parent = self.ContentFrame,
    })
    create("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6),
        Parent = container,
    })
    create("UIPadding", {
        PaddingRight = UDim.new(0, 8),
        Parent = container,
    })
    corner(container, 8)
    tab.Container = container

    btn.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then
            tween(btn, 0.15, {BackgroundTransparency = 0.3})
        end
    end)
    btn.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then
            tween(btn, 0.15, {BackgroundTransparency = 0.6})
        end
    end)
    btn.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    table.insert(self.Tabs, tab)
    if #self.Tabs == 1 then self:SelectTab(tab) end
    return tab
end

function BBS:SelectTab(tab)
    if self.ActiveTab and self.ActiveTab ~= tab then
        self.ActiveTab.Container.Visible = false
        tween(self.ActiveTab.Button, 0.15, {BackgroundTransparency = 0.6})
    end
    self.ActiveTab = tab
    tab.Container.Visible = true
    tab.Container.Position = UDim2.fromOffset(20, 0)
    tween(tab.Container, 0.2, {Position = UDim2.fromOffset(0, 0)})
    tween(tab.Button, 0.15, {BackgroundTransparency = 0})
end

