-- ============================ TOGGLE ============================
function BBS:AddToggle(tab, config)
    local T = self.Theme
    local state = config.Default or false

    local frame = create("Frame", {
        Name = "Toggle",
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = T.Element,
        BackgroundTransparency = 0.5,
        Parent = tab.Container,
    })
    corner(frame, 8)

    create("TextLabel", {
        Name = "Label",
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.fromOffset(14, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = config.Title or "Toggle",
        TextColor3 = T.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    local toggleBg = create("Frame", {
        Size = UDim2.fromOffset(36, 18),
        Position = UDim2.new(1, -50, 0.5, -9),
        BackgroundColor3 = state and T.ToggleOn or T.ToggleOff,
        Parent = frame,
    })
    corner(toggleBg, 9)

    local knob = create("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        Parent = toggleBg,
    })
    corner(knob, 7)

    local btn = create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = frame,
    })

    frame.MouseEnter:Connect(function()
        tween(frame, 0.15, {BackgroundTransparency = 0.3})
    end)
    frame.MouseLeave:Connect(function()
        tween(frame, 0.15, {BackgroundTransparency = 0.5})
    end)

    local callback = config.Callback or function() end
    btn.MouseButton1Click:Connect(function()
        state = not state
        tween(toggleBg, 0.18, {BackgroundColor3 = state and T.ToggleOn or T.ToggleOff})
        tween(knob, 0.18, {
            Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        })
        callback(state)
    end)

    return {
        Set = function(v)
            state = v
            tween(toggleBg, 0.18, {BackgroundColor3 = v and T.ToggleOn or T.ToggleOff})
            tween(knob, 0.18, {
                Position = v and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
            })
            callback(v)
        end,
        Get = function() return state end,
    }
end

