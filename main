local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "[REBIRTH 2] Crop Incremental Reborn",
    LoadingTitle = "By Fe1zik",
    LoadingSubtitle = "",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "[REBIRTH 2] Crop Incremental Reborn",
        FileName = "Settings"
    },
    Theme = "Amethyst"
})

local PlayerTab = Window:CreateTab("Player")
local AutoFarmTab = Window:CreateTab("AutoFarm")

local player = game.Players.LocalPlayer
local camera = workspace.CurrentCamera
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local moveDirection = Vector3.new()
local targetSpeed = 250
local velocityEnabled = true

local DEFAULT_WALKSPEED = 16

local function captureDefaultWalkSpeed()
    local char = player.Character
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    if humanoid and humanoid.WalkSpeed > 0 then
        DEFAULT_WALKSPEED = humanoid.WalkSpeed
    end
end

if player.Character then
    captureDefaultWalkSpeed()
end
player.CharacterAdded:Connect(function()
    task.wait(0.5)
    captureDefaultWalkSpeed()
end)

local keyMap = {
    [Enum.KeyCode.W] = Vector3.new(0, 1),
    [Enum.KeyCode.S] = Vector3.new(0, -1),
    [Enum.KeyCode.A] = Vector3.new(-1, 0),
    [Enum.KeyCode.D] = Vector3.new(1, 0),
}

local function setSpeed(newSpeed)
    newSpeed = math.clamp(newSpeed, 1, 2000)
    targetSpeed = newSpeed
end

_G.SetPlayerSpeed = setSpeed

-- Восстанавливает нормальную скорость и обнуляет горизонтальную скорость.
local function restoreWalk()
    local char = player.Character
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if humanoid then
        humanoid.WalkSpeed = DEFAULT_WALKSPEED
    end
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
    end
end

-- ===== МГНОВЕННАЯ ТЕЛЕПОРТАЦИЯ =====
local function instantTeleport(cframe)
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    hrp.CFrame = cframe
    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    local vec = keyMap[input.KeyCode]
    if vec then moveDirection = moveDirection + vec end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    local vec = keyMap[input.KeyCode]
    if vec then moveDirection = moveDirection - vec end
end)

local function applyVelocity(character, localDir)
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    if localDir.Magnitude > 0 then
        local cameraCF = camera.CFrame
        local forward = cameraCF.LookVector
        local right = cameraCF.RightVector

        forward = Vector3.new(forward.X, 0, forward.Z).Unit
        right = Vector3.new(right.X, 0, right.Z).Unit

        local worldDir = (forward * localDir.Y + right * localDir.X).Unit
        local velocity = worldDir * targetSpeed
        rootPart.AssemblyLinearVelocity = Vector3.new(velocity.X, rootPart.AssemblyLinearVelocity.Y, velocity.Z)
    else
        rootPart.AssemblyLinearVelocity = Vector3.new(0, rootPart.AssemblyLinearVelocity.Y, 0)
    end
end

local character = player.Character or player.CharacterAdded:Wait()
RunService.Heartbeat:Connect(function()
    if not velocityEnabled then return end
    character = player.Character or character
    if character then
        applyVelocity(character, moveDirection)
    end
end)

local farmActive = false
local farmThread = nil

local velocityToggle
local farmToggle

velocityToggle = PlayerTab:CreateToggle({
    Name = "Velocity Speed",
    CurrentValue = true,
    Flag = "VelocityToggle",
    Callback = function(Value)
        if Value and farmActive then
            Rayfield:Notify({
                Title = "Velocity",
                Content = "Disable AutoFarm first",
                Duration = 2,
            })
            if velocityToggle then velocityToggle:Set(false) end
            return
        end

        velocityEnabled = Value
        if Value then
            Rayfield:Notify({
                Title = "Velocity",
                Content = "Enabled",
                Duration = 1.5,
            })
        else
            restoreWalk()
            Rayfield:Notify({
                Title = "Velocity",
                Content = "Disabled, normal speed restored",
                Duration = 1.5,
            })
        end
    end,
})

PlayerTab:CreateInput({
    Name = "Custom Speed (1-2000)",
    CurrentValue = "250",
    PlaceholderText = "Enter speed",
    RemoveTextAfterFocusLost = false,
    Flag = "SpeedInput",
    Callback = function(Text)
        local num = tonumber(Text)
        if num then
            num = math.clamp(num, 1, 2000)
            setSpeed(num)
            Rayfield:Notify({
                Title = "Speed Set",
                Content = "Value: " .. num,
                Duration = 1.5,
            })
        else
            Rayfield:Notify({
                Title = "Invalid Input",
                Content = "Enter a number between 1 and 2000",
                Duration = 2,
            })
        end
    end,
})

local FIELDS = {
    ["BlueBerry Field"] = {
        center = Vector3.new(11.9500179, 4.00000286, -57.9999924),
        size = Vector3.new(48.899986267089844, 6.600000381469727, 49.599998474121094),
    },
    ["Grape Field"] = {
        center = Vector3.new(-165.349991, 20.2000065, 59.7000198),
        size = Vector3.new(68.0999984741211, 6.599999904632568, 57.20000076293945),
    },
    ["SunFlower Field"] = {
        center = Vector3.new(-35.7999878, 20.2000065, -150.499985),
        size = Vector3.new(86.4000015258789, 6.599999904632568, 57.20000076293945),
    },
    ["Crystal Field"] = {
        center = Vector3.new(-314.731812, 4.20000172, -33.5044479),
        size = Vector3.new(50.79999923706055, 6.599999904632568, 47.099998474121094),
    },
    ["Candy Field"] = {
        center = Vector3.new(-274.299988, 36.0999947, -389.249939),
        size = Vector3.new(86.4000015258789, 6.599999904632568, 57.20000076293945),
    },
    ["Star Field"] = {
        center = Vector3.new(-117.949982, 59.5500031, -428.149933),
        size = Vector3.new(71.5, 6.599999904632568, 85.4000015258789),
    },
    ["Forest Field"] = {
        center = Vector3.new(-379.750031, 47.2000046, 187.100021),
        size = Vector3.new(59.29999923706055, 6.599999904632568, 52.400001525878906),
    },
    ["Strawberry Field"] = {
        center = Vector3.new(-327.478638, 21.2499924, -533.767578),
        size = Vector3.new(49.19999694824219, 6.599999904632568, 66.9000015258789),
    },
    ["Ice Field"] = {
        center = Vector3.new(-129.121918, 58.1241531, 191.566574),
        size = Vector3.new(52.899986267089844, 6.599999904632568, 72.9000015258789),
    },
    ["Mushroom Field"] = {
        center = Vector3.new(1270.19177, 19.5700035, -46.8101425),
        size = Vector3.new(65.09998321533203, 6.599999904632568, 80.9000015258789),
    },
}

local selectedFieldName = "BlueBerry Field"

local margin = 4
local gridSize = 4
local randomSpread = 1
local reachDistance = 8
local targetTimeout = 0.8
local loopDelay = 0.02

local center, size, halfX, halfZ, cellWidth, cellDepth

local currentTarget = nil
local targetSetTime = 0
local cellQueue = {}

local function shuffle(t)
    for i = #t, 2, -1 do
        local j = math.random(i)
        t[i], t[j] = t[j], t[i]
    end
    return t
end

local function updateFieldBounds()
    local f = FIELDS[selectedFieldName]
    center = f.center
    size = f.size
    halfX = (size.X / 2) - margin
    halfZ = (size.Z / 2) - margin
    cellWidth = (halfX * 2) / gridSize
    cellDepth = (halfZ * 2) / gridSize
end

local function buildGrid()
    local cells = {}
    for ix = 1, gridSize do
        for iz = 1, gridSize do
            table.insert(cells, {ix = ix, iz = iz})
        end
    end
    return shuffle(cells)
end

local function randomPointInCell(cell)
    local baseX = center.X - halfX + (cell.ix - 1) * cellWidth
    local baseZ = center.Z - halfZ + (cell.iz - 1) * cellDepth
    local rx = baseX + math.random() * cellWidth
    local rz = baseZ + math.random() * cellDepth
    return Vector3.new(rx, center.Y, rz)
end

local function pickNextTarget()
    if #cellQueue == 0 then
        cellQueue = buildGrid()
    end
    local cell = table.remove(cellQueue, 1)
    return randomPointInCell(cell)
end

local function farmLoop()
    while farmActive do
        local char = player.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChild("Humanoid")
            if hrp and humanoid then
                humanoid.WalkSpeed = 0

                local now = tick()

                if not currentTarget then
                    currentTarget = pickNextTarget()
                    targetSetTime = now
                end

                local offset = currentTarget - hrp.Position
                offset = Vector3.new(offset.X, 0, offset.Z)

                local reached = offset.Magnitude < reachDistance
                local timedOut = (now - targetSetTime) > targetTimeout

                if reached or timedOut then
                    currentTarget = pickNextTarget()
                    targetSetTime = now
                else
                    local dir = offset.Unit
                    local speed = targetSpeed * randomSpread
                    local vel = dir * speed
                    hrp.AssemblyLinearVelocity = Vector3.new(vel.X, hrp.AssemblyLinearVelocity.Y, vel.Z)
                end
            end
        end
        task.wait(loopDelay)
    end
end

-- ===== UI AUTO FARM =====
AutoFarmTab:CreateSection("Field Selection")

AutoFarmTab:CreateDropdown({
    Name = "Field",
    Options = {
        "BlueBerry Field",
        "Grape Field",
        "SunFlower Field",
        "Crystal Field",
        "Candy Field",
        "Star Field",
        "Forest Field",
        "Strawberry Field",
        "Ice Field",
        "Mushroom Field",
    },
    CurrentOption = {"BlueBerry Field"},
    Flag = "FieldDropdown",
    Callback = function(option)
        if typeof(option) == "table" then
            selectedFieldName = option[1]
        else
            selectedFieldName = option
        end
        updateFieldBounds()
        cellQueue = buildGrid()
        currentTarget = nil
        Rayfield:Notify({
            Title = "Field Changed",
            Content = selectedFieldName,
            Duration = 1.5,
        })
    end,
})

AutoFarmTab:CreateSection("AutoFarm")

farmToggle = AutoFarmTab:CreateToggle({
    Name = "AutoFarm",
    CurrentValue = false,
    Flag = "AutoFarmToggle",
    Callback = function(Value)
        if Value and velocityEnabled then
            Rayfield:Notify({
                Title = "AutoFarm",
                Content = "Disable Velocity Speed first!",
                Duration = 2,
            })
            if farmToggle then farmToggle:Set(false) end
            return
        end

        farmActive = Value
        if Value then
            updateFieldBounds()
            local f = FIELDS[selectedFieldName]
            instantTeleport(CFrame.new(f.center))
            task.wait(0.1)
            if farmThread then task.cancel(farmThread) end
            farmThread = task.spawn(farmLoop)
            Rayfield:Notify({
                Title = "AutoFarm",
                Content = "Enabled (" .. selectedFieldName .. ")",
                Duration = 1.5,
            })
        else
            if farmThread then task.cancel(farmThread); farmThread = nil end
            currentTarget = nil
            -- Восстанавливаем ходьбу, чтобы персонаж не остался стоять
            restoreWalk()
            Rayfield:Notify({
                Title = "AutoFarm",
                Content = "Disabled, speed restored",
                Duration = 1.5,
            })
        end
    end,
})

AutoFarmTab:CreateSlider({
    Name = "Randomization",
    Range = {1, 3},
    Increment = 0.1,
    Suffix = "x",
    CurrentValue = 1,
    Flag = "RandomSpread",
    Callback = function(Value)
        randomSpread = Value
    end,
})

updateFieldBounds()
cellQueue = buildGrid()
